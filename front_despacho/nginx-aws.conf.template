# Template de Nginx para AWS.
# El pipeline reemplaza las variables BACKEND_VENTAS_IP y BACKEND_DESPACHOS_IP con las IPs privadas reales.

server {
    listen 80;
    server_name _;

    # Archivos estáticos del frontend
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    # Proxy al backend de Ventas
    location /api/ventas/ {
        proxy_pass http://BACKEND_VENTAS_IP:8080/api/v1/ventas/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy al backend de Despachos
    location /api/despachos/ {
        proxy_pass http://BACKEND_DESPACHOS_IP:8081/api/v1/despachos/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
